{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/react-starter-kit",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": ["laravel", "framework"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^2.0",
    "intervention/image": "^3.11",
    "laravel/fortify": "^1.31",
    "laravel/framework": "^12.33",
    "laravel/reverb": "^1.11",
    "laravel/telescope": "^5.14",
    "laravel/tinker": "^2.10.1",
    "laravel/wayfinder": "^0.1.12",
    "nunomaduro/essentials": "^1.0",
    "spatie/laravel-permission": "^6.21"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.16",
    "barryvdh/laravel-ide-helper": "^3.6",
    "driftingly/rector-laravel": "^2.1",
    "fakerphp/faker": "^1.24",
    "laravel/boost": "^1.3",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.25",
    "laravel/sail": "^1.46",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "pestphp/pest": "^4.1",
    "pestphp/pest-plugin-laravel": "^4.0",
    "rector/rector": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "pnpx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --no-reload\" \"php artisan queue:listen --tries=1\" \"pnpm run dev\" --names=server,queue,vite --kill-others"
    ],
    "dev:ssr": [
      "pnpm run build:ssr",
      "Composer\\Config::disableProcessTimeout",
      "pnpx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
    ],
    "test": ["@php artisan config:clear --ansi", "@php artisan test"],
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan migrate --force --seed",
      "composer run generate",
      "pnpm install"
    ],
    "generate": [
      "@php artisan export:permissions",
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:models -M",
      "vendor/bin/pint",
      "vendor/bin/rector process",
      "@php artisan boost:update"
    ],
    "update-all": ["composer update", "pnpm update", "composer run generate"],
    "setup:staging": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan optimize:clear",
      "@php artisan migrate --force --seed",
      "composer run generate",
      "pnpm install",
      "pnpm run build",
      "composer run cache"
    ],
    "setup:production": [
      "composer install --optimize-autoloader --no-dev",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan optimize:clear",
      "@php artisan migrate --force --seed",
      "composer run generate",
      "pnpm install --prod",
      "pnpm run build",
      "composer run cache"
    ],
    "cache": [
      "@php artisan optimize:clear",
      "@php artisan config:cache",
      "@php artisan route:cache",
      "@php artisan view:cache",
      "@php artisan optimize",
      "@php artisan queue:restart",
      "@php artisan storage:link"
    ],
    "set-permissions": [
      "@php artisan storage:link",
      "chmod -R 775 storage",
      "chmod -R 775 bootstrap/cache"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
